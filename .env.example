# Keep real values out of Git. The guest code may be memorable; use a long,
# unrelated admin code and a random session secret of at least 32 characters.
PHOTO_ACCESS_CODE=
PHOTO_ADMIN_CODE=
PHOTO_SESSION_SECRET=

# Optional upload limits. Defaults shown below.
PHOTO_MAX_FILE_BYTES=20000000
PHOTO_MAX_FILES_PER_BATCH=20
PHOTO_MAX_PIXELS=100000000
PHOTO_UPLOADS_PER_HOUR=60

# Use "transform" with an IMAGES binding. Use "original" only when it is unavailable.
PHOTO_VARIANT_MODE=transform
